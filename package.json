{
  "name": "nginx-cn",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "基于 NGINX 官方 README 的中文落地页与文档站 · Nimbus + Bun",
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "bun run dist-server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nimbus-ds/components": "^5.68.0",
    "@nimbus-ds/icons": "^1.28.0",
    "@nimbus-ds/styles": "^9.74.0",
    "@nimbus-ds/tokens": "^9.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "packageManager": "bun@1.4.5"
}
